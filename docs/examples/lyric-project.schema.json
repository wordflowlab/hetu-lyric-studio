{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 170,
      "minLength": 1
    },
    "language_tag": {
      "enum": [
        "zh-CN",
        "en",
        "mixed"
      ]
    },
    "brief": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "kind": {
            "enum": [
              "intro",
              "verse",
              "pre_chorus",
              "chorus",
              "bridge",
              "instrumental",
              "outro",
              "other"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "order"
        ]
      },
      "maxItems": 40
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "pronunciation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "rhyme_group": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "rhyme_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "syllables": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "min_units": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "max_units": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "byte_start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000000
                },
                "quote": {
                  "type": "string",
                  "maxLength": 16000,
                  "minLength": 1
                }
              },
              "required": [
                "source_index",
                "byte_start",
                "byte_end",
                "quote"
              ]
            },
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "section_id",
          "order",
          "text",
          "pronunciation",
          "rhyme_group",
          "rhyme_key",
          "syllables",
          "min_units",
          "max_units",
          "ranges"
        ]
      },
      "maxItems": 300
    },
    "arrangement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          }
        },
        "required": [
          "id",
          "section_id",
          "order"
        ]
      },
      "maxItems": 80
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "line_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "line_id",
          "line_sha256",
          "text",
          "rationale"
        ]
      },
      "maxItems": 300
    },
    "takes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "asset_source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "lyric_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          }
        },
        "required": [
          "id",
          "title",
          "asset_source_index",
          "lyric_sha256",
          "notes"
        ]
      },
      "maxItems": 12
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "take_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "occurrence_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "line_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "line_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1800000
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800000
          }
        },
        "required": [
          "id",
          "take_id",
          "occurrence_id",
          "line_id",
          "line_sha256",
          "text",
          "start_ms",
          "end_ms"
        ]
      },
      "maxItems": 1000
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "target_kind": {
            "enum": [
              "line",
              "take"
            ]
          },
          "target_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          }
        },
        "required": [
          "id",
          "target_kind",
          "target_id",
          "target_sha256",
          "origin",
          "comment",
          "status",
          "resolution"
        ]
      },
      "maxItems": 200
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "take_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "source_text": {
            "type": "string",
            "maxLength": 65536,
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "offset_ms": {
            "type": "integer",
            "minimum": -1800000,
            "maximum": 1800000
          }
        },
        "required": [
          "id",
          "take_id",
          "source_text",
          "sha256",
          "offset_ms"
        ]
      },
      "maxItems": 20
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_plugin_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "owner_plugin_id",
          "object_id",
          "revision",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "title",
    "language_tag",
    "brief",
    "sections",
    "lines",
    "arrangement",
    "variants",
    "takes",
    "marks",
    "notes",
    "imports",
    "basis_refs"
  ]
}
